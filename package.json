{
  "name": "personal-finance",
  "version": "1.4.0",
  "description": "个人理财投资管理软件",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:main && npx wait-on http://localhost:5173 && npm run start",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "npm run build && node scripts/start-electron.js",
    "release": "npm run build && electron-builder --win --publish always",
    "release:local": "npm run build && electron-builder --win",
    "postinstall": "npx @electron/rebuild"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
